{
  "$description": "Citia Design System: the single source of design tokens. Format: DTCG (Design Tokens Community Group), colours as hex strings. Origin: INTEGRA TPS Integration (Styles/app.css, commit 88cd8e4). After editing this file run: dotnet run tools/tokens.cs",
  "$extensions": {
    "ds": {
      "name": "Citia Design System",
      "version": "2.0.0",
      "source": "TPS/TPS.Integration/Styles/app.css @ 88cd8e4",
      "storageKey": "ds-theme",
      "cssPrefix": "ds"
    }
  },
  "palette": {
    "$type": "color",
    "$description": "Primitive. Do not use directly in components; use the semantic tokens in `themes`.",
    "white": {
      "$value": "#ffffff"
    },
    "teal": {
      "500": {
        "$value": "#00a4b2",
        "$description": "Main teal. Large graphics (container fill), primary of the dark theme. White text on it is only 3.0:1, so it is not a button color for the light theme."
      },
      "600": {
        "$value": "#00838f",
        "$description": "Main teal-600. Primary of the light theme (white text ≥ 4.5:1)."
      },
      "700": {
        "$value": "#00767f",
        "$description": "Secondary of the light theme; sidebar background."
      },
      "750": {
        "$value": "#006a73",
        "$description": "Quiet teal text in the light theme."
      },
      "800": {
        "$value": "#05666f",
        "$description": "Secondary of the dark theme; dark sidebar background."
      }
    },
    "aqua": {
      "400": {
        "$value": "#00d4df",
        "$description": "Accent of the dark theme; active marker."
      }
    },
    "paper": {
      "50": {
        "$value": "#f9f9f6",
        "$description": "Off-white surface (light base-100). Review directive of 29 Oct 2026."
      },
      "100": {
        "$value": "#f1f2ee",
        "$description": "Off-white background (light base-200)."
      },
      "200": {
        "$value": "#dfe3dd",
        "$description": "Quiet line/border (light base-300)."
      }
    },
    "steel": {
      "400": {
        "$value": "#7b8a94",
        "$description": "Control border in the light theme (≥ 3:1 against the surface)."
      },
      "450": {
        "$value": "#74848f",
        "$description": "Control border in the dark theme."
      }
    },
    "slate": {
      "900": {
        "$value": "#0f172a",
        "$description": "Main ink of the light theme; neutral."
      }
    },
    "frost": {
      "50": {
        "$value": "#f6f8fa",
        "$description": "Neutral content of the light theme."
      },
      "100": {
        "$value": "#e6edf3",
        "$description": "Main ink of the dark theme."
