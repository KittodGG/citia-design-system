  "themes": {
    "$description": "Semantic tokens per theme. Theme name = value of the `data-theme` attribute. One `default` theme, one `prefersdark` theme.",
    "light": {
      "$extensions": {
        "ds": {
          "label": "Light",
          "colorScheme": "light",
          "default": true,
          "prefersdark": false,
          "themeColor": "#f9f9f6",
          "aliases": [
            "tps"
          ]
        }
      },
      "color": {
        "$type": "color",
        "base-100": {
          "$value": "{palette.paper.50}",
          "$description": "Surface: cards, tables, inputs, document sidebar."
